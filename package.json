{
  "homepage": "https://github.com/AGsalem/portfolio.git",
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "s": "react-snap"
  },
  "reactSnap": {
    "source": "dist",
    "basename": "/portfolio",
    "publicPath": "/portfolio/",
    "exclude": [
      "/assets/**"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "gh-pages": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "vite-ssg": "^28.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "react-snap": "^1.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
